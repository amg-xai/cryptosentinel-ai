# Blockchain RPC (get from Alchemy - alchemy.com)
ETH_WS_URL=wss://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE
ETH_HTTP_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE
POLYGON_WS_URL=wss://polygon-mumbai.g.alchemy.com/v2/YOUR_KEY_HERE

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cryptosentinel

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Vault (HashiCorp)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-token

# Security
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Monitoring
GRAFANA_PASSWORD=changeme
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/HERE

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
MODEL_ARTIFACTS_PATH=data/models
